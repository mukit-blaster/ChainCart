# Copy to .env at repo root for docker-compose, or per-app .env (apps/api/.env, apps/web/.env.local).
# All app-level values are read by docker-compose via interpolation.

# ---------- Postgres ----------
POSTGRES_USER=chaincart
POSTGRES_PASSWORD=chaincart_dev
POSTGRES_DB=chaincart
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_PORT=6379

# ---------- API ----------
API_PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://chaincart:chaincart_dev@postgres:5432/chaincart?schema=public
REDIS_URL=redis://redis:6379
CORS_ORIGIN=http://localhost:3000

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Stripe (placeholder — wire to your test keys)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Cloudinary (placeholder)
CLOUDINARY_CLOUD_NAME=xxx
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx

# Blockchain (placeholder)
RPC_URL=http://localhost:8545
CHAIN_ID=31337
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
PRODUCT_REGISTRY_ADDRESS=
WARRANTY_NFT_ADDRESS=

# OAuth (placeholder)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Web ----------
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://localhost:8545
NEXT_PUBLIC_PRODUCT_REGISTRY_ADDRESS=
NEXT_PUBLIC_WARRANTY_NFT_ADDRESS=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
